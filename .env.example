PORT=5000
NODE_ENV=development

# Auto-mailer (extension -> server)
# SMTP is NOT set here. Connect the sender Gmail on the website (Sender Gmail card).
# SMTP_USER / SMTP_PASS still work as an optional fallback.
AUTO_API_KEY=
# optional: AUTO_SUBJECT, AUTO_BODY (use \n for newlines), RESUME_PATH, DAILY_LIMIT=300, MIN_DELAY_MS=30000, MAX_DELAY_MS=60000, AUTO_SEND_ENABLED=true
# Resume for public repos: base64 of the PDF (or put file at server/resume/resume.pdf locally)
# RESUME_BASE64=
# RESUME_FILENAME=Satyam_Soni_Resume.pdf

# Mailer behaviour (all optional)
# MAIL_DRY_RUN=true        build and log mails, send nothing (use this to test before going live)
# MIN_FIT=0.45             skip posts that fit the resume worse than this (0 = mail everything)
# SEND_TZ_AWARE=true       send in the recruiter's 09:00-18:00 weekday hours when the time zone is known
# FOLLOWUP_ENABLED=true    one follow-up to people who did not reply
# FOLLOWUP_DAYS=6          days to wait before the follow-up
# MAX_FOLLOWUPS=1
# BLOCK_DOMAINS=a.com,b.com  BLOCK_EMAILS=x@y.com

# Optional Postgres (for example a free Neon database) so sent history, follow-ups and the Gmail login survive restarts.
# The link holds a password: put it only in the host's env, never in code or the repo.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Send through the Gmail API (HTTPS). Needed on hosts that block SMTP, such as Render's free tier.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

PORT=5000
NODE_ENV=development

# Auto-mailer (extension -> server)
SMTP_USER=
SMTP_PASS=
AUTO_API_KEY=
# optional: AUTO_SUBJECT, AUTO_BODY (use \n for newlines), RESUME_PATH, DAILY_LIMIT=300, MIN_DELAY_MS=30000, MAX_DELAY_MS=60000, AUTO_SEND_ENABLED=true
# Resume for public repos: base64 of the PDF (or put file at server/resume/resume.pdf locally)
# RESUME_BASE64=
# RESUME_FILENAME=Satyam_Soni_Resume.pdf
